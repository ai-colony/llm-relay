# Port the HTTP server listens on.
PORT=3000

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Path to the SQLite database file.
DATABASE_FILENAME=database.sqlite

# Generative (chat) upstream: base URL, model name (empty = first available), and API key.
# Used by the prompt worker and by POST /chat/completions.
# Renamed from OPENAI_URL / OPENAI_MODEL / OPENAI_KEY in 2.0.0 — the old names are no longer read.
GENERATIVE_URL=http://localhost:8080/v1
GENERATIVE_MODEL=
GENERATIVE_KEY=none

# Optional embedding upstream, typically a second llama.cpp instance on another port.
# Leave EMBEDDING_URL empty to disable embedding support entirely: /health keeps reporting only
# db + generative, and every /embedding/* route answers 503. When it is set, /health also probes
# this backend and returns 503 if it is unreachable.
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_KEY=none

# Shared by both upstreams: per-request timeout in milliseconds, and the number of transient retry
# attempts before a job is permanently failed with statusError "max_retries_exceeded".
# Renamed from OPENAI_TIMEOUT / OPENAI_MAX_RETRY_COUNT in 2.0.0.
UPSTREAM_TIMEOUT=10000
UPSTREAM_MAX_RETRY_COUNT=10

# How often (in seconds) to re-check each upstream's /models endpoint for the active model name and
# context size. Lets llm-relay pick up a model change after llama.cpp is restarted without needing
# to restart the relay itself (default 60). Renamed from OPENAI_MODEL_CACHE_TTL_SECONDS in 2.0.0.
UPSTREAM_MODEL_CACHE_TTL_SECONDS=60

# Number of prompts processed concurrently per worker tick (1–16, default 1). Also the number of
# embedding jobs claimed per tick — those are always executed one at a time, since embedding
# backends typically run with --parallel 1.
WORKER_CONCURRENCY=1

# Optional. When set, all /prompt, /chat and /embedding endpoints require
# "Authorization: Bearer <API_KEY>". /health, /status, and /metrics remain public.
API_KEY=

# Optional regex allowlist for callbackUrl. Leave empty to allow any valid URL.
# When set, only URLs matching this pattern are accepted. An invalid regex crashes
# the server on startup. Use this to prevent SSRF in untrusted deployments.
# Example: ^https://my-service\.example\.com/
CALLBACK_URL_ALLOWLIST=

# How long (in hours) to keep retrying a failed callback delivery.
# After this TTL elapses since job completion, delivery is silently abandoned (default 24).
CALLBACK_RETRY_TTL_HOURS=24

# Optional. When set, each callback POST includes an X-LLM-Relay-Signature header
# with value "hmac-sha256=<hex>" so receivers can verify the request origin.
CALLBACK_HMAC_SECRET=

# --- Hosted backend (e.g. Scaleway) --------------------------------------------------------------
# GENERATIVE_URL/EMBEDDING_URL above work equally well pointed at a hosted OpenAI-compatible API
# instead of a local llama-server — see the "Using a hosted backend" section in README.md. The two
# vars below only matter there: some hosted providers' /models response carries no context-size
# field (llama.cpp's meta.n_ctx), so GET /status would otherwise always report contextSize as
# unknown. Set these to have it report a known value instead — the live value from /models still
# wins whenever the upstream does provide one, so these are only ever a fallback.
# GENERATIVE_CONTEXTSIZE=
# EMBEDDING_CONTEXTSIZE=
